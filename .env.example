# --- Contact and newsletter forms ---------------------------------------
#
# Web3Forms (free, unlimited): create an access key at https://web3forms.com
# with your email address, then paste it here. The endpoint is inferred.
PUBLIC_WEB3FORMS_KEY=

# Optional override for any other service (Formspree, Formspark, ...).
# When set, this wins over the Web3Forms endpoint above.
PUBLIC_FORM_ENDPOINT=

# With neither set, the forms fall back to opening the visitor's mail client.
#
# Copy this file to `.env` for local dev, and add the same variable in the
# Cloudflare Pages dashboard under Settings > Variables and Secrets. Both are
# baked in at build time, so redeploy after changing them. The PUBLIC_ prefix
# is required — it tells Astro to expose the value to the browser.
