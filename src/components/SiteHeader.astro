---
import { getCollection } from 'astro:content';
import { NAV, SITE, ACTIVE_SOCIALS, isCurrent } from '../lib/site';
import SocialIcon from './SocialIcon.astro';
import CurrencySwitch from './CurrencySwitch.astro';
import { groupByContinent, countrySlug } from '../lib/geography.mjs';
import { getGuides } from '../lib/guides';

// The Guides link is conditional: an empty section would be a dead end on
// every page of the site.

const pathname = Astro.url.pathname;

const itineraries = await getCollection('itineraries', ({ data }) => !data.draft);
const continents = groupByContinent(itineraries);
const guideCount = (await getGuides()).length;
const nav = guideCount > 0 ? NAV : NAV.filter((l) => l.href !== '/guides/');
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      <img
        class="brand__mark"
        src="/favicon-192.png"
        alt=""
        width="32"
        height="32"
        decoding="async"
      />
      The Itinerary <span class="brand__accent">Wala</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {nav.map((link) => (
          <li class:list={[{ 'has-flyout': link.menu === 'continents' && continents.length > 0 }]}>
            <a
              class:list={[{ 'nav-cta': link.cta }]}
              href={link.href}
              aria-current={isCurrent(link.href, pathname) ? 'page' : undefined}
            >
              {link.label}
              {link.menu === 'continents' && continents.length > 0 && (
                <svg class="caret" viewBox="0 0 12 8" aria-hidden="true">
                  <path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor"
                        stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </a>

            {link.menu === 'continents' && continents.length > 0 && (
              <div class="flyout">
                {/* Hover or keyboard focus opens this — no JS involved, so it
                    still works if the bundle fails. */}
                <ul class="flyout__continents">
                  {/* Empty continents and regions are left out entirely: a menu
                      full of "Soon" makes the offering look unfinished. */}
                  {continents.filter((c) => !c.comingSoon).map((continent) => (
                    <li>
                      <a class="flyout__continent" href={`/continents/${continent.slug}/`}>
                        <span>{continent.name}</span>
                      </a>
                      <ul class="flyout__regions">
                        <li class="flyout__all">
                          <a href={`/continents/${continent.slug}/`}>
                            All of {continent.name} →
                          </a>
                        </li>
                        {continent.regions.filter((r) => !r.comingSoon).map((region) => (
                          <li>
                            <a
                              class="flyout__region-link"
                              href={`/continents/${continent.slug}/#${region.slug}`}
                            >
                              <span>{region.name}</span>
                              <svg class="flyout__chev" viewBox="0 0 8 12" aria-hidden="true">
                                <path d="M1.5 1 6.5 6l-5 5" fill="none" stroke="currentColor"
                                      stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                            </a>
                            <ul class="flyout__countries">
                              {region.countries.map((country) => (
                                <li>
                                  <a href={`/destinations/${countrySlug(country.name)}/`}>
                                    {country.name}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))}
                  <li class="flyout__more">
                    <a href="/contact/">More destinations coming soon →</a>
                  </li>
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <form class="header-search" action="/itineraries/" method="get" role="search" data-search-form>
        <label class="sr-only" for="site-search">Search destinations</label>
        <svg class="header-search__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
          <path d="M16.5 16.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <input
          id="site-search"
          type="search"
          name="q"
          placeholder="Search a country…"
          autocomplete="off"
          data-search
        />
      </form>

      <CurrencySwitch />


      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-nav-toggle
      >
        <span class="nav-toggle__bars" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

</header>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Primary (mobile)" data-nav-panel hidden>
    <div class="mobile-nav__inner wrap">
      <form class="header-search" action="/itineraries/" method="get" role="search">
        <label class="sr-only" for="mobile-search">Search destinations</label>
        <svg class="header-search__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
          <path d="M16.5 16.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <input id="mobile-search" type="search" name="q" placeholder="Search a country…" autocomplete="off" />
      </form>

      <ul class="mobile-nav__list">
        {nav.map((link) => (
          <li>
            <a
              class="mobile-nav__top"
              href={link.href}
              aria-current={isCurrent(link.href, pathname) ? 'page' : undefined}
            >
              {link.label}
            </a>

            {/* Collapsed by default — <details> needs no JS and no hover. */}
            {link.menu === 'continents' && continents.filter((c) => !c.comingSoon).map((continent) => (
              continent.comingSoon ? (
                <a class="mobile-nav__soon" href={`/continents/${continent.slug}/`}>
                  {continent.name}
                  <span class="flyout__soon">Soon</span>
                </a>
              ) : (
                <details class="mobile-nav__continent">
                  <summary>
                    <span>{continent.name}</span>
                  </summary>
                  <a class="mobile-nav__all" href={`/continents/${continent.slug}/`}>
                    All of {continent.name} →
                  </a>
                  {continent.regions
                    .filter((region) => !region.comingSoon)
                    .map((region) => (
                      <div class="mobile-nav__region">
                        <span class="mobile-nav__region-name">{region.name}</span>
                        <div class="mobile-nav__countries">
                          {region.countries.map((country) => (
                            <a href={`/destinations/${countrySlug(country.name)}/`}>
                              {country.name}
                            </a>
                          ))}
                        </div>
                      </div>
                    ))}
                </details>
              )
            ))}
          </li>
        ))}
      </ul>

      <div class="mobile-nav__currency"><CurrencySwitch /></div>

      <div class="mobile-nav__socials">
        {ACTIVE_SOCIALS.map((social) => (
          <a href={social.url} rel="me noopener" target="_blank">{social.label}</a>
        ))}
      </div>
    </div>
  </nav>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');

  /** Keeps --header-h honest; the header's height changes with the viewport. */
  const measureHeader = () => {
    if (!header) return;
    document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
  };
  measureHeader();
  window.addEventListener('resize', measureHeader);
  window.addEventListener('load', measureHeader);

  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      document.body.classList.toggle('nav-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    const wide = window.matchMedia('(min-width: 981px)');
    wide.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Escape closes an open flyout by dropping focus out of it.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = document.querySelector<HTMLElement>('.has-flyout:focus-within');
    open?.querySelector<HTMLAnchorElement>(':scope > a')?.focus();
  });
</script>
