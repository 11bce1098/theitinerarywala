---
/** Why these plans differ from a generic itinerary — matches the About page. */
const items = [
  {
    title: 'A route that makes sense',
    body: 'Cities connected in an order that minimises unnecessary travel, so you are not doubling back across a country to see one thing.',
    icon: 'M4 18c3-1 4-8 8-8s5 3 8 2',
  },
  {
    title: 'A pace you can actually enjoy',
    body: 'No twelve-hour sightseeing marathons just to tick another attraction off a list. Drives capped, big sights before lunch.',
    icon: 'M12 7v5l3 2M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z',
  },
  {
    title: 'A budget you can plan around',
    body: 'Realistic per-person estimates instead of a vague range wide enough to be useless — and every figure converts live.',
    icon: 'M12 3v18M8 7h6a3 3 0 0 1 0 6H8h6a3 3 0 0 1 0 6H8',
  },
  {
    title: 'The important details, flagged',
    body: 'Visa and entry requirements are called out clearly, pointing at the official source, with the date they were last checked.',
    icon: 'M6 3v18l6-4 6 4V3Z',
  },
];
---
<section class="value-band">
  <div class="value-band__inner">
    <h2 class="section-heading" data-reveal>Not just places. A plan.</h2>
    <ul class="value-grid">
      {items.map((item, i) => (
        <li class="value-item" data-reveal style={`--stagger:${i}`}>
          <span class="value-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
                 stroke-linecap="round" stroke-linejoin="round">
              <path d={item.icon} />
            </svg>
          </span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
