---
/** Why these plans differ from a generic itinerary — matches the About page. */
const items = [
  {
    title: 'Paced for the people travelling',
    body: 'Drives capped at roughly two hours, big sights before lunch, and nothing that assumes a child will queue quietly for an hour.',
    icon: 'M12 3v18M5 10l7-7 7 7',
  },
  {
    title: 'Budgets in real numbers',
    body: 'Per person, based on mid-range hotels and the tours actually linked on the page — not a range wide enough to be useless.',
    icon: 'M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18',
  },
  {
    title: 'Visa position flagged, not guessed',
    body: 'What you need depends on your passport, so every plan points you at the authority that can actually answer it rather than pretending one rule fits everyone.',
    icon: 'M4 6h16M4 12h10M4 18h7',
  },
];
---
<section class="value-band">
  <div class="value-band__inner">
    <h2 class="section-heading" data-reveal>Why these plans work</h2>
    <ul class="value-grid">
      {items.map((item, i) => (
        <li class="value-item" data-reveal style={`--stagger:${i}`}>
          <span class="value-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
                 stroke-linecap="round" stroke-linejoin="round">
              <path d={item.icon} />
            </svg>
          </span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
