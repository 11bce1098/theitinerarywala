---
import { currencyFor } from '../lib/geography.mjs';
import { getRates, convert, formatMoney, rateDate, rateCheckUrl } from '../lib/rates.mjs';
import { DEFAULT_CURRENCY } from '../lib/site';

interface Props {
  amount?: number;
  currency: string;
  country: string;
  /** Cards show the reader's currency only; the itinerary page adds the local one. */
  variant?: 'compact' | 'full';
}
const { amount, currency, country, variant = 'compact' } = Astro.props;

const local = currencyFor(country);
const data = await getRates();
const rates = data?.rates;

// Rendered in the default currency at build time so the figure is right
// without JavaScript; the client re-renders it in whichever the reader picks.
const display = amount !== undefined ? convert(amount, currency, DEFAULT_CURRENCY, rates) : null;
const localValue = amount !== undefined ? convert(amount, currency, local, rates) : null;

const displayText = display !== null ? formatMoney(display, DEFAULT_CURRENCY) : null;
const localText = localValue !== null ? formatMoney(localValue, local) : null;
const fallback = amount !== undefined ? formatMoney(amount, currency) : 'TBC';
---
{amount === undefined ? (
  <span>TBC</span>
) : (
  <span
    data-budget
    data-amount={amount}
    data-from={currency}
    data-local={local}
    data-variant={variant}
  >
    {displayText
      ? (variant === 'full' && localText ? `${displayText} · ${localText}` : displayText)
      : fallback}
  </span>
)}

{variant === 'full' && amount !== undefined && displayText && (
  <span class="rate-note">
    Converted at the rate for{' '}
    <a href={rateCheckUrl(DEFAULT_CURRENCY, local)} rel="noopener" target="_blank" data-rate-date>
      {rateDate(data?.updated ?? '') || 'today'}
    </a>
  </span>
)}
