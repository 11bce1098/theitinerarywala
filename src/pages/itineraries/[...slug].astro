---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CoverArt from '../../components/CoverArt.astro';
import SectionTabs from '../../components/SectionTabs.astro';
import { splitItinerary, splitByH3 } from '../../lib/itinerary';
import { regionFor, continentFor, CONTINENTS } from '../../lib/geography.mjs';
import Budget from '../../components/Budget.astro';

export async function getStaticPaths() {
  const itineraries = await getCollection('itineraries', ({ data }) => !data.draft);
  return itineraries.map((itin) => ({
    params: { slug: itin.id },
    props: { itin, all: itineraries },
  }));
}

const { itin, all } = Astro.props;

/**
 * Search engines cut titles around 60 characters and descriptions around
 * 155. Long editorial headlines are right on the page but get truncated
 * mid-sentence in results, so derive a shorter form for the tag.
 */
function seoTitle(title: string, country: string, days: number): string {
  const suffix = ' — The Itinerary Wala';
  if (title.length + suffix.length <= 60) return title + suffix;
  // "Siberian winter: Baikal ice, the Trans-Siberian and…" -> "Siberian winter"
  const head = title.split(/\s*[:—–]\s*/)[0];
  // Only add context the head is missing — otherwise it reads
  // "Georgia in 7 days: 7 days in Georgia".
  const hasLength = /\d+\s*days?/i.test(head);
  const hasCountry = head.toLowerCase().includes(country.toLowerCase());
  const candidate =
    hasLength || hasCountry || head.length > 40
      ? head
      : `${head}: ${days} days in ${country}`;
  return (candidate.length + suffix.length <= 60 ? candidate : head) + suffix;
}

function seoDescription(summary: string): string {
  if (summary.length <= 155) return summary;
  const cut = summary.slice(0, 152);
  const at = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf(' — '), cut.lastIndexOf(', '));
  return (at > 90 ? cut.slice(0, at) : cut.trimEnd()) + '…';
}
const { intro, days, extras } = splitItinerary(itin.rendered?.html ?? '');
// The overview's subsections tab the same way the days do.
const { lead, sections: preTrip } = splitByH3(intro);

// Only claim commission on pages that actually carry a partner link.
const hasAffiliateLinks = (itin.body ?? '').includes('#aff:');

const updated = (itin.data.updatedDate ?? itin.data.publishDate).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const facts = [
  { label: 'Country', value: itin.data.country },
  { label: 'Region', value: regionFor(itin.data.country) },
  { label: 'Length', value: `${itin.data.days} days` },
  // Only ever a passport-agnostic note; the real answer depends on the reader.
  { label: 'Visa', value: itin.data.visaNote ?? 'Depends on your passport' },
  { label: 'Best for', value: itin.data.bestFor },
  { label: 'Updated', value: updated },
];

// Other destinations, for the sidebar beside the closing sections.
const otherCountries = [...new Set(all.map((i) => i.data.country))]
  .filter((name) => name !== itin.data.country)
  .sort()
  .map((name) => ({
    name,
    region: regionFor(name),
    count: all.filter((i) => i.data.country === name).length,
  }));

const continent = CONTINENTS.find((c) => c.slug === continentFor(itin.data.country));

const related = all
  .filter((other) => other.id !== itin.id)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---
<Base
  title={seoTitle(itin.data.title, itin.data.country, itin.data.days)}
  description={seoDescription(itin.data.summary)}
  image={itin.data.heroWide ?? itin.data.heroImage}
  progress
>
  <section class="itin-hero">
    <div class="itin-hero__art">
      <CoverArt
        seed={itin.id}
        country={itin.data.country}
        src={itin.data.heroImage}
        wide={itin.data.heroWide}
        focus={itin.data.heroFocus}
        alt={itin.data.title}
        eager
      />
    </div>
    <div class="wrap itin-hero__content">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Itineraries</a></li>
          <li><a href={`/?country=${encodeURIComponent(itin.data.country)}`}>{itin.data.country}</a></li>
          <li aria-current="page">{itin.data.days} days</li>
        </ol>
      </nav>
      <h1>{itin.data.title}</h1>
      <p class="summary">{itin.data.summary}</p>
      <ul class="facts">
        <li class="pill pill--visa">{regionFor(itin.data.country)}</li>
        <li class="pill">{itin.data.days} days</li>
        <li class="pill"><Budget amount={itin.data.budgetAmount} currency={itin.data.budgetCurrency} country={itin.data.country} /> / person</li>
        <li class="pill">{itin.data.bestFor}</li>
      </ul>
    </div>
  </section>

  <div class="itin">
    <section class="itin-band" aria-labelledby="overview-heading">
      <div class="itin-band__inner">
        <h2 class="band-heading" id="overview-heading">Before you go</h2>
        <div class="itin-overview">
          <aside class="glance" aria-label="At a glance">
            <h3>At a glance</h3>
            <dl>
              {facts.slice(0, 2).map((fact) => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
              <div>
                <dt>Budget</dt>
                <dd>
                  <Budget
                    amount={itin.data.budgetAmount}
                    currency={itin.data.budgetCurrency}
                    country={itin.data.country}
                    variant="full"
                  />
                </dd>
              </div>
              {facts.slice(2).map((fact) => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>
          </aside>
          <div class="itin-overview__main">
            <div class="prose-body" set:html={lead} />
            {preTrip.length > 0 && (
              <SectionTabs sections={preTrip} railTitle="Before you go" idPrefix="pre" />
            )}
          </div>
        </div>
      </div>
    </section>

    {days.length > 0 && (
      <section class="itin-band itin-band--tinted" aria-labelledby="days-heading">
        <div class="itin-band__inner">
          <h2 class="band-heading" id="days-heading">Day by day</h2>
          <SectionTabs sections={days} railTitle="The week" idPrefix="day" steppers rail />
        </div>
      </section>
    )}

    {extras.length > 0 && (
      <section class="itin-band" aria-labelledby="details-heading">
        <div class="itin-band__inner">
          <h2 class="band-heading" id="details-heading">Costs and practicalities</h2>
          <div class="itin-extras">
            <div class="itin-extras__main">
              {/* One trailing section is just a section; several are worth tabbing. */}
              {extras.length > 1 ? (
                <SectionTabs sections={extras} railTitle="In this section" idPrefix="more" />
              ) : (
                extras.map((section) => (
                  <div class="prose-body" set:html={section.html} />
                ))
              )}
            </div>

            {otherCountries.length > 0 && (
              <aside class="side-card" aria-label="Other destinations">
                <h3>More destinations</h3>
                <ul class="side-card__chips">
                  {otherCountries.map((country) => (
                    <li>
                      <a href={`/?country=${encodeURIComponent(country.name)}`}>{country.name}</a>
                    </li>
                  ))}
                </ul>
                <div class="side-card__foot">
                  {continent && (
                    <a href={`/continents/${continent.slug}/`}>All of {continent.name} →</a>
                  )}
                  <a href="/">Every itinerary →</a>
                </div>
              </aside>
            )}
          </div>

          <p class="footnote">
            <span aria-hidden="true">*</span>{' '}
            {hasAffiliateLinks && (
              <>
                Some links here are affiliate links — booking through them
                supports this site at no extra cost to you.{' '}
              </>
            )}
            Prices and entry rules change, and what you need depends on your
            passport; last checked {updated}, so confirm with the embassy or
            your airline before booking.
          </p>
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="itin-band itin-band--tinted" aria-labelledby="related-heading">
        <div class="itin-band__inner">
          <h2 class="band-heading" id="related-heading">Other itineraries</h2>
          <ul class="related-grid">
            {related.map((other) => (
              <li class="related-card">
                <div class="related-card__cover">
                  <CoverArt
                    seed={other.id}
                    country={other.data.country}
                    src={other.data.heroImage}
                    alt={other.data.title}
                  />
                </div>
                <div class="related-card__body">
                  <h3><a class="card-link" href={`/itineraries/${other.id}/`}>{other.data.title}</a></h3>
                  <p>{other.data.days} days · {other.data.budgetPerPerson} / person</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </div>
</Base>

<script>
  import { trackProgress } from '../../scripts/progress';
  import { refreshBudgets } from '../../scripts/rates';
  import { reveal } from '../../scripts/reveal';

  trackProgress('.read-progress__bar', '.itin');
  refreshBudgets();

  // Markdown headings only exist after the content is injected, so tag them here.
  document
    .querySelectorAll('.prose-body h3, .daytabs__panel > h2')
    .forEach((el) => el.setAttribute('data-reveal', ''));
  reveal();
</script>
