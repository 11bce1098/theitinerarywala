---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CoverArt from '../../components/CoverArt.astro';
import Budget from '../../components/Budget.astro';
import { regionFor, continentFor, countrySlug, CONTINENTS } from '../../lib/geography.mjs';
import { getRates, convert } from '../../lib/rates.mjs';
import { breadcrumbs, itemList } from '../../lib/schema';
import { DAY_BANDS, BUDGET_BANDS, perDay, bandsWithTrips } from '../../lib/finder.mjs';

const itineraries = (await getCollection('itineraries', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const countries = [...new Set(itineraries.map((i) => i.data.country))].sort();

// One list per continent, in declared order; only continents with something.
const groups = CONTINENTS
  .map((c) => ({
    ...c,
    items: itineraries.filter((i) => continentFor(i.data.country) === c.slug),
  }))
  .filter((g) => g.items.length > 0);

const jsonLd = [
  breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Itineraries', path: '/itineraries/' }]),
  itemList('All itineraries', itineraries.map((i) => ({
    name: i.data.title, path: `/itineraries/${i.id}/`,
  }))),
];

// Sorting has to compare across currencies, so normalise to USD up front.
const rateData = await getRates();
function budgetValue(amount: number | undefined, currency: string): number {
  if (amount === undefined) return Number.MAX_SAFE_INTEGER;
  const usd = convert(amount, currency, 'USD', rateData?.rates);
  return usd ?? amount;
}
// Only offer a band that leads somewhere; see bandsWithTrips.
const rates = itineraries.map((i) => perDay(
  budgetValue(i.data.budgetAmount, i.data.budgetCurrency), i.data.days,
));
const dayBands = bandsWithTrips(DAY_BANDS, itineraries.map((i) => i.data.days));
const budgetBands = bandsWithTrips(BUDGET_BANDS, rates);
---
<Base
  title="All itineraries — The Itinerary Wala"
  description="Every day-by-day itinerary on the site, with realistic pacing and budgets in real numbers. Narrow by destination, trip length and budget per day."
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">Itineraries</li>
        </ol>
      </nav>
      <h1 data-reveal>All itineraries</h1>
      <p class="page-hero__lede" data-reveal>
        Every route on the site. Narrow it down by where you fancy, how long
        you have, and what you want to spend a day.
      </p>
    </div>
  </section>

  <section class="wrap" id="all">
    <form class="finder" data-finder data-reveal>
      <div class="finder__fields">
        <div class="finder__field">
          <label for="f-q">Where</label>
          <input id="f-q" type="search" name="q" list="finder-countries"
                 placeholder="Anywhere" autocomplete="off" data-search />
          <datalist id="finder-countries">
            {countries.map((name) => <option value={name}></option>)}
          </datalist>
        </div>
        <div class="finder__field">
          <label for="f-days">How long</label>
          <select id="f-days" name="days">
            <option value="">Any length</option>
            {dayBands.map((band) => <option value={band.slug}>{band.label} · {band.short}</option>)}
          </select>
        </div>
        <div class="finder__field">
          <label for="f-budget">Budget</label>
          <select id="f-budget" name="budget">
            <option value="">Any budget</option>
            {budgetBands.map((band) => (
              <option value={band.slug}>{band.label} · {band.short}</option>
            ))}
          </select>
        </div>
        <div class="finder__field">
          <label for="f-sort">Sort by</label>
          <select id="f-sort" data-sort>
            <option value="newest">Newest</option>
            <option value="shortest">Shortest trip</option>
            <option value="cheapest">Lowest budget</option>
          </select>
        </div>
      </div>
      <p class="finder__status">
        <strong data-count>{itineraries.length}</strong>
        <span data-count-label>trips</span>
        <button class="finder__clear" type="button" data-clear hidden>Clear filters</button>
      </p>
    </form>

      <div data-grid>
        {groups.map((group, gi) => (
          <section class="dest-group" data-group={group.slug}>
            <div class="dest-group__head" data-reveal>
              <h2 class="section-heading">{group.name}</h2>
              <a class="dest-group__all" href={`/continents/${group.slug}/`}>
                All of {group.name} →
              </a>
            </div>
            <ul class="itinerary-grid">
          {group.items.map((itin, i) => (
            <li
              class="itinerary-card"
              data-reveal
              style={`--stagger:${i}`}
              data-country={itin.data.country}
              data-search-text={`${itin.data.title} ${itin.data.country} ${itin.data.summary} ${itin.data.bestFor}`.toLowerCase()}
              data-days={itin.data.days}
              data-budget-usd={budgetValue(itin.data.budgetAmount, itin.data.budgetCurrency)}
              data-per-day={perDay(budgetValue(itin.data.budgetAmount, itin.data.budgetCurrency), itin.data.days) ?? ''}
              data-date={itin.data.publishDate.valueOf()}
            >
              <div class="itinerary-card__cover">
                <CoverArt
                  seed={itin.id}
                  country={itin.data.country}
                  src={itin.data.heroImage}
                  alt={itin.data.title}
                  eager={gi === 0 && i < 2}
                />
                <span class="pill pill--visa">{regionFor(itin.data.country)}</span>
              </div>
              <div class="itinerary-card__body">
                <p class="card-bestfor"><span>Best for:</span> {itin.data.bestFor}</p>
                <h2>
                  <a class="card-link" href={`/itineraries/${itin.id}/`}>{itin.data.title}</a>
                </h2>
                {itin.data.route && <p class="card-route">{itin.data.route}</p>}
                <p>{itin.data.summary}</p>
                <div class="card-meta">
                  <span class="pill">{itin.data.days} days</span>
                  <span class="pill"><Budget amount={itin.data.budgetAmount} currency={itin.data.budgetCurrency} country={itin.data.country} /> / person</span>
                </div>
              </div>
            </li>
          ))}
            </ul>
          </section>
        ))}
      </div>

    <p class="grid-empty" data-empty hidden>
      No itineraries for that filter yet — more are on the way.
    </p>
  </section>
</Base>

<script>
  import { DAY_BANDS, BUDGET_BANDS, inBand } from '../../lib/finder.mjs';

  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const form = document.querySelector<HTMLFormElement>('[data-finder]');

  if (grid && form) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.itinerary-card'));
    const sortSelect = form.querySelector<HTMLSelectElement>('[data-sort]')!;
    const daysSelect = form.querySelector<HTMLSelectElement>('[name="days"]')!;
    const budgetSelect = form.querySelector<HTMLSelectElement>('[name="budget"]')!;
    const countEl = form.querySelector<HTMLElement>('[data-count]')!;
    const countLabel = form.querySelector<HTMLElement>('[data-count-label]')!;
    const clearBtn = form.querySelector<HTMLButtonElement>('[data-clear]')!;

    // The header carries a search box on every page; on this one it should
    // drive the grid rather than reload it, so both inputs stay in step.
    const searches = Array.from(document.querySelectorAll<HTMLInputElement>('[data-search]'));

    let query = '';
    let activeCountry = 'all';

    const comparators: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      newest: (a, b) => Number(b.dataset.date) - Number(a.dataset.date),
      shortest: (a, b) => Number(a.dataset.days) - Number(b.dataset.days),
      cheapest: (a, b) => Number(a.dataset.budgetUsd) - Number(b.dataset.budgetUsd),
    };

    /** The homepage finder submits here, so read its answers back off the URL. */
    const params = new URLSearchParams(location.search);
    const initialQuery = params.get('q');
    if (initialQuery) {
      query = initialQuery.trim().toLowerCase();
      searches.forEach((el) => { el.value = initialQuery; });
    }
    // Older inbound links used ?country=; still honour them.
    const requestedCountry = params.get('country');
    if (requestedCountry) activeCountry = requestedCountry;
    for (const [param, select, bands] of [
      ['days', daysSelect, DAY_BANDS],
      ['budget', budgetSelect, BUDGET_BANDS],
    ] as const) {
      const value = params.get(param);
      if (value && bands.some((b) => b.slug === value)) select.value = value;
    }

    const syncUrl = () => {
      const url = new URL(location.href);
      for (const [key, value] of [
        ['q', query],
        ['days', daysSelect.value],
        ['budget', budgetSelect.value],
        ['country', activeCountry === 'all' ? '' : activeCountry],
      ]) {
        if (value) url.searchParams.set(key, value);
        else url.searchParams.delete(key);
      }
      history.replaceState(null, '', url);
    };

    const apply = () => {
      const days = DAY_BANDS.find((b) => b.slug === daysSelect.value);
      const budget = BUDGET_BANDS.find((b) => b.slug === budgetSelect.value);
      let visible = 0;

      for (const card of cards) {
        const length = Number(card.dataset.days);
        const rate = card.dataset.perDay ? Number(card.dataset.perDay) : null;

        const byQuery = !query || (card.dataset.searchText ?? '').includes(query);
        const byCountry = activeCountry === 'all' || card.dataset.country === activeCountry;
        const byDays = !days || inBand(days, length);
        // A trip with no budget on it can't honestly answer a budget
        // question, so it drops out rather than guessing its way in.
        const byBudget = !budget || inBand(budget, rate);

        const match = byQuery && byCountry && byDays && byBudget;
        card.hidden = !match;
        if (match) visible++;
      }

      // A continent heading with nothing under it reads as a dead end, so
      // sections fold away when the filter empties them.
      for (const section of grid.querySelectorAll<HTMLElement>('[data-group]')) {
        section.hidden = !Array.from(section.querySelectorAll<HTMLElement>('.itinerary-card'))
          .some((card) => !card.hidden);
      }

      if (empty) empty.hidden = visible > 0;
      countEl.textContent = String(visible);
      countLabel.textContent = visible === 1 ? 'trip' : 'trips';
      clearBtn.hidden = !query && !daysSelect.value && !budgetSelect.value && activeCountry === 'all';

      const order = comparators[sortSelect.value] ?? comparators.newest;
      // Reordering via `order` keeps the grid from re-running entry
      // animations the way re-appending the nodes would.
      [...cards].sort(order).forEach((card, i) => {
        card.style.order = String(i);
      });
    };

    const update = () => { syncUrl(); apply(); };

    // Filtering happens live, so submitting would only throw the answer away.
    form.addEventListener('submit', (event) => event.preventDefault());
    document
      .querySelector<HTMLFormElement>('[data-search-form]')
      ?.addEventListener('submit', (event) => event.preventDefault());

    daysSelect.addEventListener('change', update);
    budgetSelect.addEventListener('change', update);
    sortSelect.addEventListener('change', apply);

    searches.forEach((input) => {
      input.addEventListener('input', () => {
        query = input.value.trim().toLowerCase();
        searches.forEach((other) => { if (other !== input) other.value = input.value; });
        update();
      });
    });

    clearBtn.addEventListener('click', () => {
      query = '';
      activeCountry = 'all';
      daysSelect.value = '';
      budgetSelect.value = '';
      searches.forEach((el) => { el.value = ''; });
      update();
    });

    apply();

    // Live rates land after first paint; budgets shift, so recompute both the
    // per-day figure the budget filter reads and the cheapest-first order.
    document.addEventListener('rates:updated', () => {
      for (const card of cards) {
        const el = card.querySelector<HTMLElement>('[data-budget]');
        if (!el?.dataset.usd) continue;
        card.dataset.budgetUsd = el.dataset.usd;
        const days = Number(card.dataset.days);
        card.dataset.perDay = days ? String(Number(el.dataset.usd) / days) : '';
      }
      apply();
    });
  }
</script>
