---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CoverArt from '../../components/CoverArt.astro';
import { groupByContinent } from '../../lib/geography.mjs';
import Budget from '../../components/Budget.astro';
import { regionSlug } from '../../lib/geography.mjs';

export async function getStaticPaths() {
  const itineraries = await getCollection('itineraries', ({ data }) => !data.draft);
  // Only continents that actually have itineraries get a page.
  // No page for an empty continent — nothing links to one any more.
  return groupByContinent(itineraries).filter((c) => !c.comingSoon).map((continent) => ({
    params: { slug: continent.slug },
    props: { continent },
  }));
}

const { continent } = Astro.props;

// Countries sit under their region heading, so "Asia" is not one flat list.
// Declared order, and only the regions that actually have something in them.
// Share card: the newest guide anywhere on this continent.
const newest = continent.countries
  .flatMap((c) => c.itineraries)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())[0];
const shareImage = newest?.data.heroWide ?? newest?.data.heroImage;

const regions = continent.regions
  .filter((r) => !r.comingSoon)
  .map((r) => ({ region: r.name, countries: r.countries }));

---
<Base
  title={`${continent.name} itineraries — The Itinerary Wala`}
  description={continent.comingSoon
    ? `${continent.name} itineraries are coming soon to The Itinerary Wala.`
    : `Day-by-day itineraries in ${continent.name}: ${continent.countries.map((c) => c.name).join(', ')}.`}
  image={shareImage}
>
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Itineraries</a></li>
          <li aria-current="page">{continent.name}</li>
        </ol>
      </nav>
      <h1 data-reveal>{continent.name}</h1>
      <p class="page-hero__lede" data-reveal>{continent.blurb}</p>
    </div>
  </section>

  {continent.comingSoon && (
    <section class="wrap section">
      <div class="coming-soon" data-reveal>
        <h2>{continent.name} is coming soon</h2>
        <p>
          Nothing here yet. Itineraries go up once the entry rules, the daily
          pace and the budget have all been checked properly — so this page
          stays empty rather than filling it with guesswork. These are the
          parts of {continent.name} it will cover:
        </p>
        <ul class="soon-regions">
          {continent.regions.map((region) => <li>{region.name}</li>)}
        </ul>
        <a class="btn btn--solid" href="/contact/">Request a destination</a>
      </div>
    </section>
  )}

  {regions.map((group) => (
    <section class="wrap section">
      <h2 class="section-heading" id={regionSlug(group.region)} data-reveal>{group.region}</h2>
      {group.countries.map((country) => (
        <div class="country-block">
          <h3 class="country-block__name" data-reveal>{country.name}</h3>
          <ul class="itinerary-grid">
            {country.itineraries.map((itin, i) => (
              <li class="itinerary-card" data-reveal style={`--stagger:${i}`}>
                <div class="itinerary-card__cover">
                  <CoverArt
                    seed={itin.id}
                    country={itin.data.country}
                    src={itin.data.heroImage}
                    alt={itin.data.title}
                  />
                  <span class="pill pill--visa">{country.region}</span>
                </div>
                <div class="itinerary-card__body">
                  <h4>
                    <a class="card-link" href={`/itineraries/${itin.id}/`}>{itin.data.title}</a>
                  </h4>
                  <p>{itin.data.summary}</p>
                  <div class="card-meta">
                    <span class="pill">{itin.data.days} days</span>
                    <span class="pill"><Budget amount={itin.data.budgetAmount} currency={itin.data.budgetCurrency} country={itin.data.country} /> / person</span>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  ))}

  <section class="wrap section">
    <aside class="cta-card" data-reveal>
      <div>
        <h2>Somewhere in {continent.name} you want covered?</h2>
        <p>Tell me where — it helps decide what gets researched next.</p>
      </div>
      <a class="btn btn--solid" href="/contact/">Get in touch</a>
    </aside>
  </section>
</Base>
