---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';

/*
  TODO(owner): this page currently describes only what the site already does
  — state the visa position on each itinerary and answer questions by email.

  It deliberately does not claim to file applications, quote fees, or promise
  turnaround times, because none of that is set up yet and getting it wrong on
  a visa page is the worst place to be wrong. When you decide what you are
  actually offering, replace the "What I can help with" list and add pricing.
*/
const helps = [
  {
    title: 'The rule, stated on every itinerary',
    body: `Each plan opens with the visa position for an Indian passport held by
      a UAE resident, checked on the date shown on the page. That is the first
      thing to read, before flights or hotels.`,
  },
  {
    title: 'A second pair of eyes before you book',
    body: `If a rule looks ambiguous, or your residence status is unusual, send
      the details and I will tell you what I can see — and say plainly when it
      needs the embassy rather than me.`,
  },
  {
    title: 'A heads-up when something changes',
    body: `Visa rules move. When one changes on a destination already covered
      here, the itinerary gets updated and re-dated rather than quietly left.`,
  },
];
---
<Base
  title="Visa services — The Itinerary Wala"
  description="How visa information works on The Itinerary Wala: the rule stated on every itinerary, checked and dated, for Indian passports with UAE residence."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Visa services</p>
      <h1 data-reveal>The visa question, answered before you book.</h1>
      <p class="page-hero__lede" data-reveal>
        Almost every trip from the UAE on an Indian passport starts with the
        same question, and most travel sites skip it. Here it is the first
        line of every itinerary.
      </p>
    </div>
  </section>

  <section class="wrap section">
    <ul class="method">
      {helps.map((item, i) => (
        <li class="method__item" data-reveal style={`--stagger:${i}`}>
          <span class="method__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h2>{item.title}</h2>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>

    <div class="prose" data-reveal>
      <h2>What this is not</h2>
      <p>
        This is not a visa agency. I do not file applications on your behalf,
        take documents, or charge a fee — and I would be wary of anyone who
        offers to do that over email without a licence.
      </p>
      <p>
        For anything binding, the embassy or consulate of the country you are
        visiting is the only authority. Airlines will also confirm what they
        will board you with, which is often the faster answer.
      </p>

      <h2>One thing worth repeating</h2>
      <p>
        Visa rules change with very little notice and can depend on your
        specific residence status, your passport's remaining validity, and
        occasionally on where you are flying from. Everything here is checked
        when written and dated on the page. Confirm before you book anything
        expensive.
      </p>
    </div>

    <aside class="cta-card" data-reveal>
      <div>
        <h2>Not sure where you stand?</h2>
        <p>Send the details and I will tell you what I can see.</p>
      </div>
      <a class="btn btn--solid" href={`mailto:${SITE.email}`}>Email a question</a>
    </aside>
  </section>
</Base>
