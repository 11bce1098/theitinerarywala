---
import Base from '../../layouts/Base.astro';
import { topicsWithGuides, TOPICS } from '../../lib/topics.mjs';
import { countrySlug } from '../../lib/geography.mjs';
import { breadcrumbs, itemList } from '../../lib/schema';
import { getGuides } from '../../lib/guides';

/**
 * The guides index. Grouped by topic rather than listed flat, because
 * "visas" and "when to go" are different questions and a reader arrives
 * with one of them, not with a desire to browse.
 */
const guides = (await getGuides())
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const grouped = topicsWithGuides(guides);

const jsonLd = [
  breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Guides', path: '/guides/' }]),
  itemList('Travel guides', guides.map((g) => ({ name: g.data.title, path: `/guides/${g.id}/` }))),
];
---
<Base
  title="Travel guides — The Itinerary Wala"
  description="Practical answers to the questions around a trip: visas and entry, when to go, getting around, money, and the small things that change how a trip feels."
  jsonLd={jsonLd}
  noindex={guides.length === 0}
>
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">Guides</li>
        </ol>
      </nav>
      <h1 data-reveal>Travel guides</h1>
      <p class="page-hero__lede" data-reveal>
        The questions that sit around an itinerary rather than inside one —
        what you need to get in, when to go, and how to get about once
        you&rsquo;re there.
      </p>
    </div>
  </section>

  {guides.length === 0 ? (
    <section class="wrap section">
      <div class="coming-soon" data-reveal>
        <h2>Guides are on the way</h2>
        <p>
          Nothing here yet. Guides go up once they answer a question properly
          rather than restating what is already in an itinerary — so this page
          stays empty instead of filling it with filler. In the meantime, every
          itinerary carries its own visa, transport and budget notes.
        </p>
        <a class="btn btn--solid" href="/itineraries/">Browse itineraries</a>
      </div>
    </section>
  ) : (
    grouped.map((topic) => (
      <section class="wrap section">
        <div class="popular__head" data-reveal>
          <div>
            <h2 class="section-heading">{topic.name}</h2>
            <p class="section-sub">{topic.blurb}</p>
          </div>
        </div>
        <ul class="guide-list">
          {topic.guides.map((guide, i) => (
            <li class="guide-card" data-reveal style={`--stagger:${i}`}>
              <a href={`/guides/${guide.id}/`}>
                <span class="guide-card__topic">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={topic.icon} />
                  </svg>
                  {guide.data.country ?? 'Everywhere'}
                </span>
                <span class="guide-card__title">{guide.data.title}</span>
                <span class="guide-card__summary">{guide.data.summary}</span>
                <span class="guide-card__go">Read the guide →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  )}
</Base>
