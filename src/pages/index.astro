---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CoverArt from '../components/CoverArt.astro';
import { countrySlug, continentFor, CONTINENTS } from '../lib/geography.mjs';
import { POPULAR } from '../lib/site';
import Budget from '../components/Budget.astro';
import ValueProps from '../components/ValueProps.astro';
import { website, itemList } from '../lib/schema';
import { STYLES, stylesFor } from '../lib/styles.mjs';
import { getRates, convert } from '../lib/rates.mjs';

/**
 * The homepage is a landing page, not the catalogue — that lives at
 * /itineraries/. Its one job is to get a visitor to an itinerary, so it
 * offers four routes in: search, a featured trip, a travel style, or a
 * country. Everything else supports that.
 */
const itineraries = (await getCollection('itineraries', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const popular = POPULAR
  .map((id) => itineraries.find((i) => i.id === id))
  .filter((i): i is NonNullable<typeof i> => Boolean(i));

const latest = itineraries.slice(0, 6);

/** Countries with the most guides — the search suggestions worth offering. */
const topCountries = [...itineraries.reduce((m, i) => {
  m.set(i.data.country, (m.get(i.data.country) ?? 0) + 1);
  return m;
}, new Map<string, number>()).entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 6)
  .map(([name]) => name);

// Budget is computed from cost per day so it can't drift; the rest are
// editorial tags on each guide.
const rateData = await getRates();
const perDay = new Map(
  itineraries.map((itin) => {
    const amount = itin.data.budgetAmount;
    if (amount === undefined) return [itin.id, null];
    const usd = convert(amount, itin.data.budgetCurrency, 'USD', rateData?.rates) ?? amount;
    return [itin.id, usd / itin.data.days];
  }),
);
const styleGroups = STYLES.map((style) => {
  const matches = itineraries.filter((i) => stylesFor(i, perDay.get(i.id)).includes(style.slug));
  return {
    ...style,
    count: matches.length,
    countries: (style.feature ?? []).filter((c) => matches.some((i) => i.data.country === c))
      .concat([...new Set(matches.map((i) => i.data.country))])
      .filter((c, i, a) => a.indexOf(c) === i)
      .slice(0, 3),
  };
}).filter((s) => s.count > 0);

/**
 * Continents with their countries as plain links. This used to render 37
 * image tiles, which was most of the page's height for a list people scan
 * rather than browse — the images do their work further up.
 */
const destinations = CONTINENTS
  .map((c) => ({
    ...c,
    countries: [...new Set(
      itineraries.filter((i) => continentFor(i.data.country) === c.slug).map((i) => i.data.country),
    )].sort(),
  }))
  .filter((c) => c.countries.length > 0);

const steps = [
  { n: '01', title: 'Pick a destination', body: 'Choose a ready-made itinerary, or tell me where you want to go.' },
  { n: '02', title: 'Check the plan', body: 'See the route, the day-by-day schedule and a realistic budget.' },
  { n: '03', title: 'Make it yours', body: 'Adjust it around your dates, your interests and how you travel.' },
  { n: '04', title: 'Book and go', body: 'Use the links on the page and start planning the fun parts.' },
];

const jsonLd = [
  website(),
  itemList('Popular trip plans', popular.map((i) => ({
    name: i.data.title, path: `/itineraries/${i.id}/`,
  }))),
];
---
<Base
  title="The Itinerary Wala — day-by-day travel itineraries"
  description="Day-by-day travel itineraries with realistic pacing, budgets in real numbers, and every stay and tour bookable in one tap."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <h1 data-reveal>Travel plans you can actually follow.</h1>
      <p class="hero__lede" data-reveal>
        Day-by-day itineraries, realistic budgets and practical travel
        guidance — planned around the destination, your dates and how you
        actually like to travel.
      </p>
      <p class="hero__actions" data-reveal>
        <a class="btn btn--solid btn--lg" href="/itineraries/">Browse itineraries</a>
        <a class="btn btn--ghost btn--lg" href="/plan/">Plan my trip</a>
      </p>
      <p class="hero__eyebrow hero__eyebrow--under" data-reveal>
        Day-by-day plans · Realistic budgets · Practical tips
      </p>
    </div>
  </section>

  <section class="wrap section find" aria-labelledby="find-heading">
    <h2 class="section-heading" id="find-heading" data-reveal>Where do you want to go?</h2>
    <div class="find__inner" data-reveal>
      <form class="find__form" action="/itineraries/" method="get" role="search">
        <label class="sr-only" for="home-search">Search a country or destination</label>
        <svg class="find__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
          <path d="M16.5 16.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <input
          id="home-search"
          type="search"
          name="q"
          placeholder="Search a country or destination…"
          autocomplete="off"
        />
        <button class="btn btn--solid" type="submit">Search</button>
      </form>
      <p class="find__suggest">
        <span>Popular:</span>
        {topCountries.map((name) => (
          <a href={`/destinations/${countrySlug(name)}/`}>{name}</a>
        ))}
        <a class="find__all" href="#destinations">Explore all destinations →</a>
      </p>
    </div>
  </section>

  {popular.length > 0 && (
    <section class="wrap section popular">
      <div class="popular__head" data-reveal>
        <div>
          <h2 class="section-heading">Start with a trip that&rsquo;s already planned.</h2>
          <p class="section-sub">
            Pick a destination, follow the route, and spend less time working
            out what to do next.
          </p>
        </div>
        <a class="popular__all" href="/itineraries/">View all itineraries →</a>
      </div>
      <ul class="popular__list">
        {popular.map((itin, i) => (
          <li class="popular__item" data-reveal style={`--stagger:${i}`}>
            <a href={`/itineraries/${itin.id}/`}>
              <span class="popular__art">
                <CoverArt
                  seed={itin.id}
                  country={itin.data.country}
                  src={itin.data.heroImage}
                  alt=""
                  eager={i < 2}
                />
                <span class="popular__days">{itin.data.days} days</span>
              </span>
              <span class="popular__body">
                <span class="popular__country">{itin.data.country}</span>
                <span class="popular__route">{itin.data.route ?? itin.data.title}</span>
                <span class="popular__price">
                  <Budget amount={itin.data.budgetAmount} currency={itin.data.budgetCurrency} country={itin.data.country} /> / person
                </span>
                <span class="popular__go">View itinerary →</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="wrap section" id="styles">
    <div class="popular__head" data-reveal>
      <h2 class="section-heading">What kind of trip are you planning?</h2>
      <a class="popular__all" href="/itineraries/">See every itinerary →</a>
    </div>
    <ul class="style-grid">
      {styleGroups.map((style, i) => (
        <li class="style-card" data-reveal style={`--stagger:${i}`}>
          <a href={`/styles/${style.slug}/`}>
            <span class="style-card__icon" aria-hidden="true">{style.icon}</span>
            <span class="style-card__name">{style.name}</span>
            <span class="style-card__countries">{style.countries.join(' · ')}</span>
            <span class="style-card__go">Explore {style.name.toLowerCase()} →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <ValueProps />

  <section class="wrap section">
    <div class="popular__head" data-reveal>
      <div>
        <h2 class="section-heading">More trips. Already planned.</h2>
        <p class="section-sub">Pick a destination — the route is worked out.</p>
      </div>
      <a class="popular__all" href="/itineraries/">See all itineraries →</a>
    </div>
    <ul class="itinerary-grid">
      {latest.map((itin, i) => (
        <li class="itinerary-card" data-reveal style={`--stagger:${i}`}>
          <div class="itinerary-card__cover">
            <CoverArt
              seed={itin.id}
              country={itin.data.country}
              src={itin.data.heroImage}
              alt={itin.data.title}
              eager={i < 2}
            />
            <span class="pill pill--visa">{itin.data.country}</span>
          </div>
          <div class="itinerary-card__body">
            <p class="card-bestfor">{itin.data.bestFor}</p>
            <h2>
              <a class="card-link" href={`/itineraries/${itin.id}/`}>{itin.data.title}</a>
            </h2>
            {itin.data.route && <p class="card-route">{itin.data.route}</p>}
            <div class="card-meta">
              <span class="pill">{itin.data.days} days</span>
              <span class="pill">
                <Budget amount={itin.data.budgetAmount} currency={itin.data.budgetCurrency} country={itin.data.country} /> / person
              </span>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="how">
    <div class="wrap">
      <h2 class="section-heading" data-reveal>Planning a trip shouldn&rsquo;t take weeks.</h2>
      <ol class="how__grid">
        {steps.map((step, i) => (
          <li class="how__item" data-reveal style={`--stagger:${i}`}>
            <span class="how__num" aria-hidden="true">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="wrap section">
    <div class="build" data-reveal>
      <h2>Don&rsquo;t know where to start?</h2>
      <p>
        Tell me your destination, dates, budget and travel style, and
        I&rsquo;ll turn it into a practical trip plan.
      </p>
      <p class="build__meta">Destination · Dates · Budget · Travel style</p>
      <a class="btn btn--solid btn--lg" href="/plan/">Build my trip →</a>
    </div>
  </section>

  <section class="wrap section">
    <div class="meet" data-reveal>
      <img
        class="meet__shot"
        src="/images/nitesh-himalaya.jpeg"
        alt="Nitesh Parasher on a Himalayan pass"
        width="675"
        height="900"
        loading="lazy"
        decoding="async"
      />
      <div class="meet__body">
        <h2 class="section-heading">Hi, I&rsquo;m Nitesh.</h2>
        <p>
          I&rsquo;m the person friends and family come to when they need a trip
          planned — routes, hotels, transport, budgets and all the little
          details in between.
        </p>
        <p>
          After doing it for years, I decided to build those itineraries for
          everyone.
        </p>
        <a class="btn btn--ghost" href="/about/">My story →</a>
      </div>
    </div>
  </section>

  <section class="wrap section" id="destinations">
    <div class="popular__head" data-reveal>
      <h2 class="section-heading">Explore destinations</h2>
      <a class="popular__all" href="/itineraries/">All itineraries →</a>
    </div>
    <ul class="dest-list">
      {destinations.map((continent) => (
        <li class="dest-list__row" data-reveal>
          <h3>
            <a href={`/continents/${continent.slug}/`}>{continent.name}</a>
          </h3>
          <p>
            {continent.countries.map((name, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <a href={`/destinations/${countrySlug(name)}/`}>{name}</a>
              </>
            ))}
          </p>
        </li>
      ))}
    </ul>
  </section>
</Base>
