---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CoverArt from '../components/CoverArt.astro';
import Testimonials from '../components/Testimonials.astro';
import ValueProps from '../components/ValueProps.astro';

const itineraries = (await getCollection('itineraries', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const countries = [...new Set(itineraries.map((i) => i.data.country))].sort();
const totalDays = itineraries.reduce((sum, i) => sum + i.data.days, 0);

/** "AED 2,800" -> 2800, so the cheapest-first sort has something to compare. */
function budgetValue(display: string): number {
  const digits = display.replace(/[^\d]/g, '');
  return digits ? Number(digits) : Number.MAX_SAFE_INTEGER;
}

const stats = [
  { value: itineraries.length, label: itineraries.length === 1 ? 'itinerary' : 'itineraries' },
  { value: countries.length, label: countries.length === 1 ? 'country' : 'countries' },
  { value: totalDays, label: 'days planned' },
];
---
<Base
  title="The Itinerary Wala — visa-smart family itineraries"
  description="Day-by-day travel itineraries for families on Indian passports with UAE residence: visa notes, real budgets, and bookable plans."
>
  <section class="hero">
    <div class="wrap">
      <p class="hero__eyebrow" data-reveal>Indian passport · UAE residence</p>
      <h1 data-reveal>Itineraries that already know your passport.</h1>
      <p class="hero__lede" data-reveal>
        Day-by-day plans for families travelling on Indian passports with UAE
        residence — visa requirements checked, budgets in real numbers, and
        every hotel and tour bookable in one tap.
      </p>

      <svg class="hero__route" viewBox="0 0 600 40" aria-hidden="true" role="presentation">
        <path
          class="hero__route-line"
          d="M 8 30 C 120 30, 140 10, 240 12 S 400 30, 500 14 L 592 12"
          fill="none"
        />
        {[8, 240, 500, 592].map((x, i) => (
          <circle class="hero__route-pin" style={`--i:${i}`} cx={x} cy={i === 0 ? 30 : i === 1 ? 12 : 13} r="5" />
        ))}
      </svg>

      <dl class="stats" data-reveal>
        {stats.map((stat) => (
          <div class="stat">
            <dt class="stat__value" data-count-to={stat.value}>0</dt>
            <dd class="stat__label">{stat.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="wrap">
    {countries.length > 1 && (
      <div class="filters" data-reveal>
        <div class="filters__group" role="group" aria-label="Filter by country">
          <button class="chip" type="button" data-filter="all" aria-pressed="true">
            All
          </button>
          {countries.map((country) => (
            <button class="chip" type="button" data-filter={country} aria-pressed="false">
              {country}
            </button>
          ))}
        </div>
        <label class="filters__sort">
          <span>Sort</span>
          <select data-sort>
            <option value="newest">Newest</option>
            <option value="shortest">Shortest trip</option>
            <option value="cheapest">Lowest budget</option>
          </select>
        </label>
      </div>
    )}

    <ul class="itinerary-grid" data-grid>
      {itineraries.map((itin, index) => (
        <li
          class="itinerary-card"
          data-reveal
          style={`--stagger:${index}`}
          data-country={itin.data.country}
          data-days={itin.data.days}
          data-budget={budgetValue(itin.data.budgetPerPerson)}
          data-date={itin.data.publishDate.valueOf()}
        >
          <div class="itinerary-card__cover">
            <CoverArt
              seed={itin.id}
              country={itin.data.country}
              src={itin.data.heroImage}
              alt={itin.data.title}
              eager={index < 2}
            />
            <span class="pill pill--visa">{itin.data.visaNote}</span>
          </div>
          <div class="itinerary-card__body">
            <h2>
              <a class="card-link" href={`/itineraries/${itin.id}/`}>{itin.data.title}</a>
            </h2>
            <p>{itin.data.summary}</p>
            <div class="card-meta">
              <span class="pill">{itin.data.days} days</span>
              <span class="pill">{itin.data.budgetPerPerson} / person</span>
              <span class="pill">{itin.data.bestFor}</span>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <p class="grid-empty" data-empty hidden>
      No itineraries for that filter yet — more are on the way.
    </p>
  </section>

  <ValueProps />

  <Testimonials />
</Base>

<script>
  // --- filter + sort ---------------------------------------------------
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const sortSelect = document.querySelector<HTMLSelectElement>('[data-sort]');

  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.itinerary-card'));
    let activeCountry = 'all';

    const comparators: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      newest: (a, b) => Number(b.dataset.date) - Number(a.dataset.date),
      shortest: (a, b) => Number(a.dataset.days) - Number(b.dataset.days),
      cheapest: (a, b) => Number(a.dataset.budget) - Number(b.dataset.budget),
    };

    // Footer links arrive as /?country=Georgia — honour that on load.
    const requested = new URLSearchParams(location.search).get('country');
    if (requested && chips.some((c) => c.dataset.filter === requested)) {
      activeCountry = requested;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === requested)));
    }

    const apply = () => {
      let visible = 0;
      for (const card of cards) {
        const match = activeCountry === 'all' || card.dataset.country === activeCountry;
        card.hidden = !match;
        if (match) visible++;
      }
      if (empty) empty.hidden = visible > 0;

      const order = comparators[sortSelect?.value ?? 'newest'] ?? comparators.newest;
      // Reordering via `order` keeps the grid from re-running entry
      // animations the way re-appending the nodes would.
      [...cards].sort(order).forEach((card, i) => {
        card.style.order = String(i);
      });
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        activeCountry = chip.dataset.filter!;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        const url = new URL(location.href);
        if (activeCountry === 'all') url.searchParams.delete('country');
        else url.searchParams.set('country', activeCountry);
        history.replaceState(null, '', url);
        apply();
      });
    });
    sortSelect?.addEventListener('change', apply);
    apply();
  }

  // --- stat count-up ---------------------------------------------------
  const counters = Array.from(document.querySelectorAll<HTMLElement>('[data-count-to]'));
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const countUp = (el: HTMLElement) => {
    const target = Number(el.dataset.countTo) || 0;
    if (still || target === 0) {
      el.textContent = String(target);
      return;
    }
    const duration = 900;
    const start = performance.now();
    const tick = (now: number) => {
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = String(Math.round(target * eased));
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  if (counters.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          countUp(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.6 }
    );
    counters.forEach((el) => observer.observe(el));
  }
</script>
