---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CoverArt from '../components/CoverArt.astro';
import { regionFor, countrySlug, continentFor, CONTINENTS } from '../lib/geography.mjs';
import { POPULAR } from '../lib/site';
import Budget from '../components/Budget.astro';
import ValueProps from '../components/ValueProps.astro';

/**
 * The homepage is a landing page, not the catalogue. At 29 guides the full
 * grid buried Europe and North America under 19 Asia cards and never
 * answered "what does this site cover?" in one screen. The catalogue lives
 * at /itineraries/; this page shows coverage, then the newest work.
 */
const itineraries = (await getCollection('itineraries', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Featured trips, in the order set in site.ts; anything missing is skipped.
const popular = POPULAR
  .map((id) => itineraries.find((i) => i.id === id))
  .filter((i): i is NonNullable<typeof i> => Boolean(i));

const latest = itineraries.slice(0, 6);

// Countries grouped under their continent, biggest first inside each, so the
// browse block reads as a map of what exists rather than an alphabet.
const destinations = CONTINENTS
  .map((c) => {
    const counts = new Map<string, number>();
    for (const itin of itineraries) {
      if (continentFor(itin.data.country) !== c.slug) continue;
      counts.set(itin.data.country, (counts.get(itin.data.country) ?? 0) + 1);
    }
    return {
      ...c,
      countries: [...counts.entries()]
        .map(([name, count]) => ({
          name,
          count,
          // The newest guide for a country supplies the tile image.
          cover: itineraries.find((i) => i.data.country === name)!,
        }))
        .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name)),
    };
  })
  .filter((c) => c.countries.length > 0);

---
<Base
  title="The Itinerary Wala — day-by-day travel itineraries"
  description="Day-by-day travel itineraries with realistic pacing, budgets in real numbers, and every stay and tour bookable in one tap."
>
  <section class="hero">
    <div class="wrap">
      <p class="hero__eyebrow" data-reveal>Day-by-day plans · Realistic budgets · Practical tips</p>
      <h1 data-reveal>Travel plans you can actually follow.</h1>
      <p class="hero__lede" data-reveal>
        Day-by-day itineraries, realistic budgets and practical travel
        guidance — planned around the destination, the dates and how you
        actually like to travel.
      </p>
      <p class="hero__actions" data-reveal>
        <a class="btn btn--solid btn--lg" href="/itineraries/">
          Browse all itineraries
        </a>
        <a class="btn btn--ghost btn--lg" href="/plan/">Plan my trip</a>
      </p>
    </div>
  </section>

  {popular.length > 0 && (
    <section class="wrap section popular">
      <div class="popular__head" data-reveal>
        <h2 class="section-heading">Popular trip plans</h2>
        <a class="popular__all" href="/itineraries/">View all itineraries →</a>
      </div>
      <ul class="popular__list">
        {popular.map((itin, i) => (
          <li class="popular__item" data-reveal style={`--stagger:${i}`}>
            <a href={`/itineraries/${itin.id}/`}>
              <span class="popular__country">{itin.data.country}</span>
              <span class="popular__days">{itin.data.days} days</span>
              <span class="popular__route">{itin.data.route ?? itin.data.title}</span>
              <span class="popular__price">
                <Budget amount={itin.data.budgetAmount} currency={itin.data.budgetCurrency} country={itin.data.country} /> / person
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="wrap section" id="destinations">
    <div class="popular__head" data-reveal>
      <h2 class="section-heading">Browse by destination</h2>
      <span class="dest-count">Every country we cover</span>
    </div>

    {destinations.map((continent) => (
      <div class="dest-continent">
        <h3 class="dest-continent__name" data-reveal>
          <a href={`/continents/${continent.slug}/`}>{continent.name}</a>
        </h3>
        <ul class="dest-tiles">
          {continent.countries.map((country, i) => (
            <li class="dest-tile" data-reveal style={`--stagger:${i}`}>
              <a href={`/destinations/${countrySlug(country.name)}/`}>
                <span class="dest-tile__art" aria-hidden="true">
                  <CoverArt
                    seed={country.cover.id}
                    country={country.name}
                    src={country.cover.data.heroImage}
                    alt=""
                  />
                </span>
                <span class="dest-tile__body">
                  <span class="dest-tile__name">{country.name}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section class="wrap section">
    <div class="popular__head" data-reveal>
      <h2 class="section-heading">Latest guides</h2>
      <a class="popular__all" href="/itineraries/">See all itineraries →</a>
    </div>
    <ul class="itinerary-grid">
      {latest.map((itin, i) => (
        <li class="itinerary-card" data-reveal style={`--stagger:${i}`}>
          <div class="itinerary-card__cover">
            <CoverArt
              seed={itin.id}
              country={itin.data.country}
              src={itin.data.heroImage}
              alt={itin.data.title}
              eager={i < 2}
            />
            <span class="pill pill--visa">{regionFor(itin.data.country)}</span>
          </div>
          <div class="itinerary-card__body">
            <p class="card-bestfor">{itin.data.bestFor}</p>
            <h2>
              <a class="card-link" href={`/itineraries/${itin.id}/`}>{itin.data.title}</a>
            </h2>
            {itin.data.route && <p class="card-route">{itin.data.route}</p>}
            <p>{itin.data.summary}</p>
            <div class="card-meta">
              <span class="pill">{itin.data.days} days</span>
              <span class="pill">
                <Budget amount={itin.data.budgetAmount} currency={itin.data.budgetCurrency} country={itin.data.country} /> / person
              </span>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <ValueProps />
</Base>
