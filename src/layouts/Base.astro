---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, GA_ID, ANALYTICS_HOST } from '../lib/site';
import { CONSENT_REGIONS, CONSENT_KEY, GRANTED, DENIED } from '../lib/consent.mjs';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  /** Itinerary pages show a reading-progress bar; other pages don't. */
  progress?: boolean;
  /** Absolute-from-root path to a social preview image. */
  image?: string;
  /** Alt text for that image, used by screen readers on shared cards. */
  imageAlt?: string;
  /** JSON-LD nodes for this page; wrapped in one @graph on output. */
  jsonLd?: Record<string, unknown>[];
  /** ISO dates for article pages. */
  published?: Date;
  modified?: Date;
  /** Keep a page out of the index — used for placeholders with no content yet. */
  noindex?: boolean;
}
const {
  title,
  description,
  progress = false,
  image,
  imageAlt,
  jsonLd = [],
  published,
  modified,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL(image ?? SITE.ogImage, canonical);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Google Analytics 4 (gtag.js) — the snippet as the GA dashboard issues
      it, with one addition: the config call is gated on the live hostname.
      Cloudflare preview deploys and `astro preview` are production builds
      too, so without that gate every look at a preview would land in the
      real property as a pageview. The library still loads everywhere, so
      Google's "Test installation" and Tag Assistant see a normal install.

      Skipped entirely in `astro dev`, where it would only be noise.
    */}
    {GA_ID && import.meta.env.PROD && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script define:vars={{
          gaId: GA_ID,
          host: ANALYTICS_HOST,
          regions: CONSENT_REGIONS,
          key: CONSENT_KEY,
          granted: GRANTED,
          denied: DENIED,
        }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          /*
           * define:vars wraps this script in an IIFE, so the declaration
           * above is local. The consent banner needs to call gtag later,
           * hence the explicit global.
           */
          window.gtag = gtag;

          /*
           * Consent Mode v2, and it has to run before config — otherwise the
           * tag sets its cookies before anyone has been asked. Naming
           * `region` is what scopes the denial: Consent Mode treats every
           * region not listed as granted, so only the EEA, the UK and
           * Switzerland start denied and nobody else is shown a banner.
           * Until a visitor there accepts, GA still receives cookieless
           * pings — they are counted, just not identified.
           */
          gtag('consent', 'default', Object.assign({}, denied, {
            region: regions,
            wait_for_update: 500,
          }));

          /*
           * A stored choice wins, anywhere in the world: someone who accepted
           * is not asked twice, and someone who opted out on the privacy page
           * stays opted out even though their region defaults to granted.
           */
          try {
            const saved = localStorage.getItem(key);
            if (saved === 'granted') gtag('consent', 'update', granted);
            else if (saved === 'denied') gtag('consent', 'update', denied);
          } catch (e) { /* private mode: leave the stricter default in place */ }

          gtag('js', new Date());
          if (location.hostname === host) gtag('config', gaId);
        </script>
      </Fragment>
    )}

    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#e85d21" />

    <meta property="og:type" content={published ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:alt" content={imageAlt ?? title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.xHandle} />
    <meta name="twitter:creator" content={SITE.xHandle} />
    {published && (
      <meta property="article:published_time" content={published.toISOString()} />
    )}
    {(modified ?? published) && (
      <meta
        property="article:modified_time"
        content={(modified ?? published)!.toISOString()}
      />
    )}

    {jsonLd.length > 0 && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd })}
      />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Karla:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Reveal-on-scroll hides things in CSS. Gate that on JS being alive so
      // the page is never blank if the bundle fails to load.
      document.documentElement.classList.add('js');
    </script>

    <!--
      Travelpayouts monetisation tag. `is:inline` keeps Astro from bundling
      it — the vendor requires this to run as-is in <head>. The attributes
      are hints for WordPress caching plugins; harmless here, kept so the
      snippet matches what the dashboard issues.
    -->
    <script
      is:inline
      nowprocket
      data-noptimize="1"
      data-cfasync="false"
      data-wpfc-render="false"
      seraph-accel-crit="1"
      data-no-defer="1"
      data-cmp-ab="2"
    >
      (function () {
        var script = document.createElement("script");
        script.async = 1;
        script.setAttribute("data-cmp-ab", "2");
        script.src = 'https://emrldtp.cc/NTczODQy.js?t=573842';
        document.head.appendChild(script);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {progress && <div class="read-progress"><span class="read-progress__bar"></span></div>}

    <SiteHeader />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />

    {GA_ID && import.meta.env.PROD && <ConsentBanner />}

    <script>
      import { reveal } from '../scripts/reveal';
      import { refreshBudgets } from '../scripts/rates';
      import { consent, consentControls } from '../scripts/consent';
      reveal();
      refreshBudgets();
      consent();
      consentControls();
    </script>
  </body>
</html>
